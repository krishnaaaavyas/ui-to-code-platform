# Server Environment Variables
PORT=4000

# DB: Leaving empty defaults to SQLite database locally (server/src/db/sqlite.db)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# CORS & Gateway origins
CLIENT_ORIGIN=http://localhost

# JWT security keys (Production startup requires keys at least 32 random characters that must NOT contain the word "secret")
JWT_ACCESS_SECRET=your_random_access_token_signing_key_at_least_32_characters
JWT_REFRESH_SECRET=your_random_refresh_token_signing_key_at_least_32_characters

# AI integration (optional, falls back to deterministic local mock scaffold if omitted)
# OPENAI_API_KEY=sk-proj-...
